datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPERADMIN
  ADMIN
  WORKER
  INVENTORY_MANAGER
  USER

  @@map("user_role")
}

enum VehicleType {
  BIKE
  CAR

  @@map("vehicle_type")
}

model Showroom {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  code         String   @unique
  address      String
  contactPhone String   @map("contact_phone")
  contactEmail String   @map("contact_email")
  logoUrl      String?  @map("logo_url")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  users       User[]
  vehicles    Vehicle[]
  spareParts  SparePart[]
  enquiries   Enquiry[]
  serviceJobs ServiceJob[]

  @@map("showrooms")
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  showroomId   String?   @map("showroom_id") @db.Uuid
  fullName     String    @map("full_name")
  phone        String    @unique
  email        String?
  passwordHash String    @map("password_hash")
  role         UserRole  @default(USER)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  showroom             Showroom?    @relation(fields: [showroomId], references: [id], onDelete: Cascade)
  enquiries            Enquiry[]
  assignedServiceJobs  ServiceJob[] @relation("WorkerAssignedJobs")

  @@map("users")
}

model Vehicle {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  showroomId    String      @map("showroom_id") @db.Uuid
  title         String
  type          VehicleType @default(BIKE)
  brand         String
  model         String
  year          Int
  price         Float
  color         String
  engineCc      Int         @map("engine_cc")
  stockQuantity Int         @default(1) @map("stock_quantity")
  description   String?
  imageUrl      String?     @map("image_url")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  showroom Showroom @relation(fields: [showroomId], references: [id], onDelete: Cascade)

  @@map("vehicles")
}

enum SparePartVehicleType {
  BIKE
  CAR
  BOTH

  @@map("spare_part_vehicle_type")
}

model SparePart {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  showroomId    String               @map("showroom_id") @db.Uuid
  partName      String               @map("part_name")
  partCode      String               @map("part_code")
  category      String               @default("General")
  vehicleType   SparePartVehicleType @default(BOTH) @map("vehicle_type")
  price         Float
  stockQuantity Int                  @default(0) @map("stock_quantity")
  minStockAlert Int                  @default(5) @map("min_stock_alert")
  description   String?
  imageUrl      String?              @map("image_url")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  showroom Showroom @relation(fields: [showroomId], references: [id], onDelete: Cascade)

  @@map("spare_parts")
}

enum EnquiryType {
  GENERAL
  VEHICLE_PURCHASE
  SPARE_PART_PURCHASE
  SERVICE_INQUIRY

  @@map("enquiry_type")
}

enum EnquiryStatus {
  PENDING
  RESPONDED
  CLOSED

  @@map("enquiry_status")
}

model Enquiry {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String?       @map("user_id") @db.Uuid
  targetShowroomId String?       @map("target_showroom_id") @db.Uuid
  broadcastToAll   Boolean       @default(false) @map("broadcast_to_all")
  enquiryType      EnquiryType   @default(GENERAL) @map("enquiry_type")
  customerName     String        @map("customer_name")
  customerPhone    String        @map("customer_phone")
  customerEmail    String?       @map("customer_email")
  message          String
  status           EnquiryStatus @default(PENDING)
  responseNotes    String?       @map("response_notes")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  targetShowroom Showroom? @relation(fields: [targetShowroomId], references: [id], onDelete: SetNull)

  @@map("enquiries")
}

enum WorkerApproval {
  PENDING
  APPROVED
  REJECTED

  @@map("worker_approval")
}

enum ServiceJobStatus {
  REQUESTED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("service_job_status")
}

model ServiceJob {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  showroomId         String           @map("showroom_id") @db.Uuid
  customerName       String           @map("customer_name")
  customerPhone      String           @map("customer_phone")
  vehicleType        VehicleType      @default(BIKE) @map("vehicle_type")
  vehicleDetails     String           @map("vehicle_details")
  serviceDescription String           @map("service_description")
  assignedWorkerId   String?          @map("assigned_worker_id") @db.Uuid
  workerApproval     WorkerApproval   @default(PENDING) @map("worker_approval")
  status             ServiceJobStatus @default(REQUESTED)
  statusNotes        String?          @map("status_notes")
  statusUpdatedAt    DateTime         @default(now()) @map("status_updated_at") @db.Timestamptz
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  showroom       Showroom @relation(fields: [showroomId], references: [id], onDelete: Cascade)
  assignedWorker User?    @relation("WorkerAssignedJobs", fields: [assignedWorkerId], references: [id], onDelete: SetNull)

  @@map("service_jobs")
}



