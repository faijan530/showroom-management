datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPERADMIN
  ADMIN
  WORKER
  INVENTORY_MANAGER
  USER

  @@map("user_role")
}

enum VehicleType {
  BIKE
  CAR

  @@map("vehicle_type")
}

model Showroom {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  code         String   @unique
  address      String
  contactPhone String   @map("contact_phone")
  contactEmail String   @map("contact_email")
  logoUrl      String?  @map("logo_url")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  users             User[]
  vehicles          Vehicle[]
  spareParts        SparePart[]
  enquiries         Enquiry[]
  serviceJobs       ServiceJob[]
  sparePartRequests SparePartRequest[]
  serviceFeedbacks  ServiceFeedback[]
  auditLogs         AuditLog[]
  activityLogs      ActivityLog[]

  @@map("showrooms")
}

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  showroomId   String?   @map("showroom_id") @db.Uuid
  fullName     String    @map("full_name")
  phone        String    @unique
  email        String?
  passwordHash String    @map("password_hash")
  role         UserRole  @default(USER)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  showroom                 Showroom?          @relation(fields: [showroomId], references: [id], onDelete: Cascade)
  enquiries                Enquiry[]
  assignedServiceJobs      ServiceJob[]       @relation("WorkerAssignedJobs")
  customerVehicles         CustomerVehicle[]
  createdServiceJobs       ServiceJob[]       @relation("CustomerCreatedJobs")
  createdSparePartRequests SparePartRequest[] @relation("CustomerCreatedPartRequests")
  assignedPartRequests     SparePartRequest[] @relation("WorkerAssignedPartRequests")
  serviceFeedbacks         ServiceFeedback[]
  auditLogs                AuditLog[]
  activityLogs             ActivityLog[]

  @@map("users")
}

model Vehicle {
  id            String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  showroomId    String      @map("showroom_id") @db.Uuid
  title         String
  type          VehicleType @default(BIKE)
  brand         String
  model         String
  year          Int
  price         Float
  color         String
  engineCc      Int         @map("engine_cc")
  stockQuantity Int         @default(1) @map("stock_quantity")
  description   String?
  imageUrl      String?     @map("image_url")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  showroom Showroom @relation(fields: [showroomId], references: [id], onDelete: Cascade)

  @@map("vehicles")
}

enum SparePartVehicleType {
  BIKE
  CAR
  BOTH

  @@map("spare_part_vehicle_type")
}

model SparePart {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  showroomId    String               @map("showroom_id") @db.Uuid
  partName      String               @map("part_name")
  partCode      String               @map("part_code")
  category      String               @default("General")
  vehicleType   SparePartVehicleType @default(BOTH) @map("vehicle_type")
  price         Float
  stockQuantity Int                  @default(0) @map("stock_quantity")
  minStockAlert Int                  @default(5) @map("min_stock_alert")
  description   String?
  imageUrl      String?              @map("image_url")
  createdAt     DateTime             @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  showroom          Showroom           @relation(fields: [showroomId], references: [id], onDelete: Cascade)
  sparePartRequests SparePartRequest[]

  @@map("spare_parts")
}

enum EnquiryType {
  GENERAL
  VEHICLE_PURCHASE
  SPARE_PART_PURCHASE
  SERVICE_INQUIRY

  @@map("enquiry_type")
}

enum EnquiryStatus {
  PENDING
  RESPONDED
  CLOSED

  @@map("enquiry_status")
}

model Enquiry {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String?       @map("user_id") @db.Uuid
  targetShowroomId String?       @map("target_showroom_id") @db.Uuid
  broadcastToAll   Boolean       @default(false) @map("broadcast_to_all")
  enquiryType      EnquiryType   @default(GENERAL) @map("enquiry_type")
  customerName     String        @map("customer_name")
  customerPhone    String        @map("customer_phone")
  customerEmail    String?       @map("customer_email")
  message          String
  status           EnquiryStatus @default(PENDING)
  responseNotes    String?       @map("response_notes")
  createdAt        DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user           User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  targetShowroom Showroom? @relation(fields: [targetShowroomId], references: [id], onDelete: SetNull)

  @@map("enquiries")
}

model CustomerVehicle {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  title       String
  vehicleType VehicleType @default(BIKE) @map("vehicle_type")
  regNumber   String      @map("reg_number")
  brand       String
  model       String
  year        Int
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceJobs ServiceJob[]

  @@map("customer_vehicles")
}

enum WorkerApproval {
  PENDING
  APPROVED
  REJECTED

  @@map("worker_approval")
}

enum ServiceJobStatus {
  REQUESTED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("service_job_status")
}

model ServiceJob {
  id                 String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  showroomId         String           @map("showroom_id") @db.Uuid
  userId             String?          @map("user_id") @db.Uuid
  customerVehicleId  String?          @map("customer_vehicle_id") @db.Uuid
  customerName       String           @map("customer_name")
  customerPhone      String           @map("customer_phone")
  vehicleType        VehicleType      @default(BIKE) @map("vehicle_type")
  vehicleDetails     String           @map("vehicle_details")
  serviceDescription String           @map("service_description")
  preferredDate      DateTime?        @map("preferred_date") @db.Timestamptz
  timeSlot           String?          @map("time_slot")
  assignedWorkerId   String?          @map("assigned_worker_id") @db.Uuid
  workerApproval     WorkerApproval   @default(PENDING) @map("worker_approval")
  status             ServiceJobStatus @default(REQUESTED)
  statusNotes        String?          @map("status_notes")
  statusUpdatedAt    DateTime         @default(now()) @map("status_updated_at") @db.Timestamptz
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  showroom        Showroom         @relation(fields: [showroomId], references: [id], onDelete: Cascade)
  user            User?            @relation("CustomerCreatedJobs", fields: [userId], references: [id], onDelete: SetNull)
  customerVehicle CustomerVehicle? @relation(fields: [customerVehicleId], references: [id], onDelete: SetNull)
  assignedWorker  User?            @relation("WorkerAssignedJobs", fields: [assignedWorkerId], references: [id], onDelete: SetNull)
  feedback        ServiceFeedback?

  @@map("service_jobs")
}

enum SparePartRequestStatus {
  REQUESTED
  UNDER_REVIEW
  ORDERED
  IN_TRANSIT
  RECEIVED
  READY
  COMPLETED
  CANCELLED

  @@map("spare_part_request_status")
}

model SparePartRequest {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String                 @map("user_id") @db.Uuid
  showroomId        String                 @map("showroom_id") @db.Uuid
  sparePartId       String?                @map("spare_part_id") @db.Uuid
  partName          String                 @map("part_name")
  quantity          Int                    @default(1)
  vehicleDetails    String?                @map("vehicle_details")
  notes             String?
  status            SparePartRequestStatus @default(REQUESTED)
  estimatedDelivery DateTime?              @map("estimated_delivery") @db.Timestamptz
  responseNotes     String?                @map("response_notes")
  assignedWorkerId  String?                @map("assigned_worker_id") @db.Uuid
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  user           User       @relation("CustomerCreatedPartRequests", fields: [userId], references: [id], onDelete: Cascade)
  showroom       Showroom   @relation(fields: [showroomId], references: [id], onDelete: Cascade)
  sparePart      SparePart? @relation(fields: [sparePartId], references: [id], onDelete: SetNull)
  assignedWorker User?      @relation("WorkerAssignedPartRequests", fields: [assignedWorkerId], references: [id], onDelete: SetNull)

  @@map("spare_part_requests")
}

enum FeedbackStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("feedback_status")
}

model ServiceFeedback {
  id            String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  showroomId    String         @map("showroom_id") @db.Uuid
  userId        String         @map("user_id") @db.Uuid
  serviceJobId  String         @unique @map("service_job_id") @db.Uuid
  rating        Int            // 1 to 5 stars
  comment       String?
  status        FeedbackStatus @default(PENDING)
  adminResponse String?        @map("admin_response")
  respondedAt   DateTime?      @map("responded_at") @db.Timestamptz
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  showroom   Showroom   @relation(fields: [showroomId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceJob ServiceJob @relation(fields: [serviceJobId], references: [id], onDelete: Cascade)

  @@map("service_feedback")
}

model AuditLog {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  showroomId String?  @map("showroom_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  String?  @map("actor_role")
  action     String
  entity     String
  entityId   String?  @map("entity_id") @db.Uuid
  metadata   Json?    @default("{}")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  showroom Showroom? @relation(fields: [showroomId], references: [id], onDelete: SetNull)
  actor    User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([showroomId, createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

model ActivityLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  showroomId    String?  @map("showroom_id") @db.Uuid
  userId        String?  @map("user_id") @db.Uuid
  type          String
  description   String
  referenceType String?  @map("reference_type")
  referenceId   String?  @map("reference_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  showroom Showroom? @relation(fields: [showroomId], references: [id], onDelete: SetNull)
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([showroomId, createdAt])
  @@map("activity_logs")
}







